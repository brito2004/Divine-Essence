# =============================================
# DIVINE ESSENCE — Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================

# Servidor
PORT=3000
NODE_ENV=development   # trocar para "production" no deploy

# Sessão — TROQUE por uma string longa e aleatória em produção!
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=TROQUE_ISSO_POR_UMA_STRING_ALEATORIA_LONGA

# ── Banco de dados ──────────────────────────
# Desenvolvimento local (SQLite):
DB_PATH=./database/divine_essence.db

# Produção (PostgreSQL no Railway):
# Quando DATABASE_URL estiver definida, SQLite é ignorado automaticamente.
# No Railway, esta variável é preenchida automaticamente ao adicionar o plugin PostgreSQL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ── Administrador inicial ───────────────────
# Usado apenas no primeiro "npm run setup" / primeiro deploy
ADMIN_EMAIL=admin@divineessence.com
ADMIN_SENHA=Admin@2024!
ADMIN_NOME=Administrador

# ── Upload de imagens ───────────────────────
MAX_FILE_SIZE=5242880   # 5 MB em bytes
UPLOAD_PATH=./src/public/images/produtos
