<%- include('partials/header') %>

<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 4rem 2rem; text-align: center;">
  <div>
    <div style="font-family: 'Cormorant Garamond', serif; font-size: 8rem; color: #F4C2D7; font-weight: 300; line-height: 1; margin-bottom: 1rem;">
      <%= codigo || '?' %>
    </div>
    <h1 style="font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 300; color: #2A1F1D; margin-bottom: 1rem;">
      <%= titulo || 'Algo deu errado' %>
    </h1>
    <p style="font-size: 0.9375rem; color: #8A7E7B; max-width: 400px; margin: 0 auto 2.5rem; line-height: 1.8;">
      <%= mensagem || 'Ocorreu um erro inesperado.' %>
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primario">Voltar ao Início</a>
      <a href="/catalogo" class="btn btn-outline">Ver Catálogo</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
