<aside class="admin-sidebar">
  <div class="admin-sidebar-logo">
    <div class="admin-sidebar-logo-nome">Divine Essence</div>
    <div class="admin-sidebar-logo-sub">Painel Admin</div>
  </div>

  <nav class="admin-nav">
    <div class="admin-nav-section">Principal</div>
    <a href="/admin/dashboard" class="admin-nav-link <%= paginaAtual === 'dashboard' ? 'ativo' : '' %>">
      <span class="admin-nav-link-icon">◈</span> Dashboard
    </a>

    <div class="admin-nav-section">Catálogo</div>
    <a href="/admin/produtos" class="admin-nav-link <%= paginaAtual === 'produtos' ? 'ativo' : '' %>">
      <span class="admin-nav-link-icon">◉</span> Produtos
    </a>
    <a href="/admin/produtos/novo" class="admin-nav-link <%= paginaAtual === 'novo-produto' ? 'ativo' : '' %>">
      <span class="admin-nav-link-icon">＋</span> Novo Produto
    </a>
    <a href="/admin/categorias" class="admin-nav-link <%= paginaAtual === 'categorias' ? 'ativo' : '' %>">
      <span class="admin-nav-link-icon">◫</span> Categorias
    </a>

    <div class="admin-nav-section">Site</div>
    <a href="/" target="_blank" class="admin-nav-link">
      <span class="admin-nav-link-icon">↗</span> Ver Site
    </a>
  </nav>

  <div class="admin-sidebar-user">
    <div class="admin-user-avatar"><%= adminNome ? adminNome.charAt(0).toUpperCase() : 'A' %></div>
    <div>
      <div style="color: white; font-size: 0.8125rem;"><%= adminNome || 'Admin' %></div>
      <a href="/admin/logout" style="font-size: 0.75rem; color: rgba(255,255,255,0.4); transition: color 0.2s;"
         onmouseover="this.style.color='#C9A96E'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
        Sair
      </a>
    </div>
  </div>
</aside>
