<%- include('partials/header') %>

<!-- Breadcrumb -->
<nav class="breadcrumb">
  <a href="/">Início</a>
  <span class="breadcrumb-sep">›</span>
  <a href="/catalogo">Catálogo</a>
  <span class="breadcrumb-sep">›</span>
  <a href="/catalogo?categoria=<%= encodeURIComponent(produto.categoria) %>"><%= produto.categoria %></a>
  <span class="breadcrumb-sep">›</span>
  <span><%= produto.nome %></span>
</nav>

<!-- Detalhe do Produto -->
<div class="produto-detalhe">
  <!-- Imagem -->
  <div>
    <div class="produto-imagem-wrapper">
      <img
        src="<%= produto.imagem && produto.imagem.startsWith('http') ? produto.imagem : '/images/' + produto.imagem %>"
        alt="<%= produto.nome %>"
        onerror="this.src='/images/placeholder.svg'"
      >
    </div>
    <% if (produto.destaque) { %>
    <div style="margin-top: 1rem; padding: 0.75rem 1rem; background: #FFF7EC; border-left: 3px solid #C9A96E; font-size: 0.8125rem; color: #8A6A3A;">
      ✦ Produto em Destaque — Selecionado especialmente para você
    </div>
    <% } %>
  </div>

  <!-- Informações -->
  <div>
    <div class="produto-info-categoria"><%= produto.categoria %></div>
    <h1 class="produto-info-nome"><%= produto.nome %></h1>

    <div class="produto-info-preco-wrapper">
      <div class="produto-info-preco">
        <small>R$</small> <%= Number(produto.preco).toFixed(2).replace('.', ',') %>
      </div>
    </div>

    <% if (produto.descricao) { %>
    <div class="produto-info-descricao">
      <%= produto.descricao %>
    </div>
    <% } %>

    <div class="produto-info-acoes">
      <a href="https://wa.me/5511991211565?text=Olá!%20Tenho%20interesse%20no%20produto:%20<%= encodeURIComponent(produto.nome) %>"
         target="_blank"
         class="btn btn-primario btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        Falar pelo WhatsApp
      </a>
      <a href="/catalogo?categoria=<%= encodeURIComponent(produto.categoria) %>" class="btn btn-outline btn-lg">
        Ver Similares
      </a>
    </div>

    <!-- Informações adicionais -->
    <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #F4C2D7;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div>
          <div style="font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: #8A7E7B; margin-bottom: 0.25rem;">Categoria</div>
          <div style="font-size: 0.9375rem; color: #2A1F1D;"><%= produto.categoria %></div>
        </div>
        <div>
          <div style="font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: #8A7E7B; margin-bottom: 0.25rem;">Código</div>
          <div style="font-size: 0.9375rem; color: #2A1F1D;">#<%= String(produto.id).padStart(4, '0') %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Produtos Relacionados -->
<% if (relacionados.length > 0) { %>
<section class="secao-fundo">
  <div class="secao-fundo-inner">
    <div class="secao-header" style="margin-bottom: 2.5rem;">
      <div class="subtitulo-secao">Você também pode gostar</div>
      <h2 class="titulo-secao">Produtos Relacionados</h2>
      <div class="secao-divider"></div>
    </div>

    <div class="grid-produtos">
      <% relacionados.forEach(rel => { %>
      <article class="card-produto">
        <div class="card-produto-imagem">
          <img
            src="/images/produtos/<%= rel.imagem %>"
            alt="<%= rel.nome %>"
            onerror="this.src='/images/placeholder.svg'"
            loading="lazy"
          >
          <div class="card-produto-overlay">
            <a href="/produto/<%= rel.id %>" class="btn btn-primario btn-sm">Ver Produto</a>
          </div>
        </div>
        <div class="card-produto-body">
          <div class="card-produto-categoria"><%= rel.categoria %></div>
          <h3 class="card-produto-nome"><%= rel.nome %></h3>
          <div class="card-produto-footer">
            <div class="card-produto-preco">
              <small>R$</small> <%= Number(rel.preco).toFixed(2).replace('.', ',') %>
            </div>
            <a href="/produto/<%= rel.id %>" class="btn btn-outline btn-sm">Ver mais</a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
